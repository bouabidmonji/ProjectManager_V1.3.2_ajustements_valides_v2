{
  "name": "project-manager-tataouine",
  "version": "1.3.2",
  "description": "Gestion locale et suivi des projets communaux - Commune de Tataouine (V1.3.2)",
  "main": "src/main.js",
  "author": "Commune de Tataouine",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^34.1.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tn.commune.tataouine.projectmanager",
    "productName": "Project Manager - Tataouine",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "seed-projects.json",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
